# انسخ الملف ده لـ .env واملأ القيم الحقيقية قبل التشغيل

# رابط قاعدة بيانات Postgres (Neon / Supabase / أي مزوّد)
DATABASE_URL="postgresql://user:password@host:5432/rihla?sslmode=require"

# مفاتيح Auth.js — ولّدها بـ: npx auth secret
AUTH_SECRET=""

# مفاتيح Web Push (VAPID) — ولّدها بـ: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:khaledessam80@gmail.com"

# مفتاح Anthropic API — لشات "الونيس" (الرفيق الذكي). هاته من console.anthropic.com
ANTHROPIC_API_KEY=""
